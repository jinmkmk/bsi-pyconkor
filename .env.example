# NEIS Open API authentication key (required)
NEIS_API_KEY=
# NEIS API origin
NEIS_BASE_URL=https://open.neis.go.kr
# NEIS request timeout in seconds (backend and MCP server)
NEIS_REQUEST_TIMEOUT=8
# MCP Streamable HTTP host port
MCP_PORT=8001
# Browser origin allowed by the backend during local development
FRONTEND_ORIGIN=http://localhost:5173
# Optional browser-visible backend origin; leave blank when using a proxy
VITE_API_BASE_URL=
