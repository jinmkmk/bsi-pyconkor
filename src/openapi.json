{
  "openapi": "3.1.0",
  "info": {
    "title": "급식 배틀 내부 API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/schools": {
      "get": {
        "operationId": "searchSchools",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "학교 검색 결과",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SchoolPage" }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "502": { "$ref": "#/components/responses/UpstreamError" },
          "503": { "$ref": "#/components/responses/UpstreamError" },
          "504": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    },
    "/api/meals": {
      "get": {
        "operationId": "getMeals",
        "parameters": [
          {
            "name": "officeCode",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "schoolCode",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "날짜순 중식 결과",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MealPage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "502": { "$ref": "#/components/responses/UpstreamError" },
          "503": { "$ref": "#/components/responses/UpstreamError" },
          "504": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "School": {
        "type": "object",
        "required": [
          "officeCode",
          "schoolCode",
          "name",
          "region",
          "schoolType",
          "address"
        ],
        "properties": {
          "officeCode": { "type": "string" },
          "schoolCode": { "type": "string" },
          "name": { "type": "string" },
          "region": { "type": "string" },
          "schoolType": { "type": "string" },
          "address": { "type": "string" }
        }
      },
      "SchoolPage": {
        "type": "object",
        "required": ["items", "totalCount", "page", "pageSize"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/School" }
          },
          "totalCount": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1 }
        }
      },
      "Meal": {
        "type": "object",
        "required": ["date", "mealType", "dishes"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "mealType": { "type": "string", "const": "중식" },
          "dishes": { "type": "array", "items": { "type": "string" } },
          "calories": { "type": ["string", "null"] },
          "nutrition": { "type": ["string", "null"] }
        }
      },
      "MealPage": {
        "type": "object",
        "required": ["school", "from", "to", "items"],
        "properties": {
          "school": {
            "type": "object",
            "required": ["officeCode", "schoolCode", "name"],
            "properties": {
              "officeCode": { "type": "string" },
              "schoolCode": { "type": "string" },
              "name": { "type": "string" }
            }
          },
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Meal" }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" },
              "fields": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "요청 검증 오류",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "UpstreamError": {
        "description": "NEIS 연동 오류",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  }
}
